# ============================================ #
#          Unity 3D Tetris - .gitignore         #
# ============================================ #

# ---------- Unity generated ---------- #
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# ---------- Visual Studio / Rider ---------- #
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE
.idea/
.vs/
.vscode/
*.swp
*.swo

# ---------- OS generated ---------- #
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- Unity Asset meta ---------- #
# Keep .meta files — they are required by Unity

# ---------- Memory / Crash dumps ---------- #
*.stackdump
Crashlytics/

# ---------- Packages ---------- #
# Keep manifest.json, ignore lock file if desired
# Packages/packages-lock.json

# ---------- Asset Store Tools ---------- #
AssetStoreTools/

# ---------- Autosave ---------- #
Autosave/
*.autosave
*.backup

# ---------- Console logs ---------- #
ConsoleLog/

# ---------- Exported packages ---------- #
*.unitypackage

# ---------- Environment ---------- #
.env
.env.local
.env.*.local
